[Desktop Entry]
Type=Application
Name=ForensiDrive
Comment=Forensic Drive Recovery and Erasure Tool
Exec=/usr/bin/python3 /usr/local/forensidrive/app/main.py
Path=/usr/local/forensidrive
Icon=drive-harddisk
Terminal=false
StartupNotify=true
Categories=System;Utility;

